{
  "name": "typeset.us",
  "version": "4.2.0",
  "description": "Measured paragraph composition for linked, styled, and changing web text, with optical hanging and a verified spacing finish.",
  "author": "Dustin York (https://typeset.us)",
  "homepage": "https://typeset.us",
  "repository": { "type": "git", "url": "git+https://github.com/speedwarnsf/web-typography.git" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/typeset.release.d.ts",
  "typesVersions": { "*": { "react": ["dist/typeset.release.react.d.ts"] } },
  "exports": {
    ".": {
      "import": { "types": "./dist/typeset.release.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/typeset.release.d.cts", "default": "./dist/index.cjs" }
    },
    "./react": {
      "import": { "types": "./dist/typeset.release.react.d.ts", "default": "./dist/react.js" },
      "require": { "types": "./dist/typeset.release.react.d.cts", "default": "./dist/react.cjs" },
      "default": { "types": "./dist/typeset.release.react.d.ts", "default": "./dist/react.js" }
    },
    "./global": { "types": "./dist/global.d.ts", "default": "./dist/typeset.global.js" },
    "./go": { "types": "./dist/go.d.ts", "default": "./dist/go.js" },
    "./styles.css": "./dist/styles.css",
    "./capabilities.json": "./capabilities.json",
    "./package.json": "./package.json"
  },
  "files": ["dist", "bin", "README.md", "AGENTS.md", "MIGRATION.md", "SUPPORT.md", "for-agents.md", "capabilities.json", "LICENSE", "THIRD-PARTY-LICENSES.txt", "UNICODE-LICENSE.txt"],
  "bin": { "typeset-audit": "./bin/audit.mjs" },
  "sideEffects": ["./dist/styles.css", "./dist/typeset.global.js", "./dist/go.js"],
  "engines": { "node": ">=22" },
  "publishConfig": { "tag": "latest", "access": "public" },
  "peerDependencies": { "react": "^19.2.3", "playwright": "^1.58.2" },
  "peerDependenciesMeta": { "react": { "optional": true }, "playwright": { "optional": true } },
  "license": "MIT"
}
