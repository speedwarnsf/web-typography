{
  "name": "typeset.us",
  "version": "3.4.0",
  "description": "Paragraph compositor for the browser: beam-search line breaking with syntactic bindings, contour-shaped rag, hanging punctuation, and post-render self-verification. The engine behind typeset.us.",
  "license": "MIT",
  "author": "Dustin York (https://typeset.us)",
  "homepage": "https://typeset.us",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speedwarnsf/web-typography.git"
  },
  "keywords": [
    "typography",
    "typesetting",
    "line-breaking",
    "knuth-plass",
    "rag",
    "widows",
    "orphans",
    "text-wrap"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/typeset.core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/typeset.core.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./global": "./dist/typeset.global.js"
  },
  "bin": {
    "typeset.us": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "playwright-core": "^1.58.0"
  },
  "sideEffects": false,
  "funding": "https://typeset.us/support"
}
